# Production settings for docker-compose.prod.yml. On the server: bash deploy/init-env.sh <cloudfront-domain>
# creates .env from this file and fills in the generated secrets; then fill in the rest with: nano .env
# Never commit .env.

# --- Generated by deploy/init-env.sh (leave empty here) -----------------------------------------
POSTGRES_PASSWORD=
SESSION_SECRET=
DOCUMENT_SERVICE_TOKEN=

# --- Public URL (your CloudFront domain, https://, no trailing slash) ----------------------------
WEB_ORIGIN=https://YOUR-DISTRIBUTION.cloudfront.net
APP_BASE_URL=https://YOUR-DISTRIBUTION.cloudfront.net
COMPANY_NAME=HireByte

# --- Demo recruiter account (created by the seed command; password at least 12 characters) -------
SEED_RECRUITER_EMAIL=
SEED_RECRUITER_PASSWORD=
SEED_RECRUITER_NAME=

# --- AI interviewer: Google Gemini key from https://aistudio.google.com/apikey ------------------
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=

# --- LiveKit Cloud (live video, phone camera): Settings > Keys ----------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Recording stays off for the demo (needs LiveKit + an S3 bucket; see deploy/README.md) -------
RECORDING_ENABLED=false

LOG_LEVEL=info
