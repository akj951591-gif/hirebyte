# HireByte API configuration. Copy to backend/api/.env (git-ignored) and fill in.
# Everything here is server-only: never copy these values into frontend VITE_ variables.

# --- Web / API -----------------------------------------------------------------------------------
PORT=4000
# Browser origin(s) allowed to call the API with cookies (comma-separated).
WEB_ORIGIN=http://localhost:5173
# Public URL of the frontend, used to build candidate invitation and phone pairing links.
APP_BASE_URL=http://localhost:5173
# Local Docker database (npm run db:up). Tests use TEST_DATABASE_URL and wipe it on every run.
DATABASE_URL=postgresql://hirebyte:hirebyte_local_dev@localhost:5432/hirebyte
TEST_DATABASE_URL=postgresql://hirebyte:hirebyte_local_dev@localhost:5432/hirebyte_test
# At least 32 random characters. Used to hash session tokens and encrypt access codes.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
LOG_LEVEL=info
COMPANY_NAME=HireByte
# Only when deployed behind proxies: how many to trust for the client IP (CloudFront → nginx = 2).
TRUST_PROXY_HOPS=

# --- Seed recruiter (npm run db:seed) -----------------------------------------------------------
SEED_RECRUITER_EMAIL=
SEED_RECRUITER_PASSWORD=
SEED_RECRUITER_NAME=

# --- LiveKit (server-only secret) ---------------------------------------------------------------
# From LiveKit Cloud > Settings > Keys. URL looks like wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Webhooks are signed with LIVEKIT_API_KEY/SECRET, so no separate webhook secret is needed.
# Point LiveKit Cloud webhooks at: https://<public-api-host>/api/webhooks/livekit/egress

# --- Recording storage (server only, PRIVATE bucket) -------------------------------------------
# Any S3-compatible service. Supabase Storage setup:
#   1. Supabase dashboard > Storage > New bucket (keep "Public bucket" OFF), e.g. "recordings".
#   2. Project Settings > Storage > S3 Connection: enable it, copy the Region, create an access key.
#   3. Your project ref is the "<ref>" in https://<ref>.supabase.co
# These keys have full storage access: keep them server-side only. LiveKit also uses them to upload.
STORAGE_PROVIDER=supabase
SUPABASE_PROJECT_REF=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=recordings
# Optional: set instead of SUPABASE_PROJECT_REF for other providers (e.g. Cloudflare R2, AWS S3).
STORAGE_ENDPOINT=
STORAGE_SIGNED_URL_TTL_SECONDS=300
# (Older R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET_NAME names still work.)

# --- Recording policy ----------------------------------------------------------------------------
# true requires all LiveKit and STORAGE_* settings above; the API refuses to start otherwise.
RECORDING_ENABLED=false
RECORDING_MODE=composite
# Days to keep recordings (shown to candidates). Leave empty until the team agrees on a period.
RECORDING_RETENTION_DAYS=

# --- AI (server only): questions, evaluation and the interviewer conversation -------------------
# Google Gemini (free tier): create a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=
# A current model name, e.g. gemini-3.8-flash (see https://ai.google.dev/gemini-api/docs/models)
LLM_MODEL=
# Optional: defaults to the provider's OpenAI-compatible endpoint. Also supported: xai, groq.
LLM_BASE_URL=
LLM_TIMEOUT_MS=60000
# The interviewer's reply between questions; slower replies are skipped so the interview moves on.
CONVERSATION_TIMEOUT_MS=8000
# (Older XAI_API_KEY / XAI_MODEL names still work with LLM_PROVIDER=xai.)

# --- Python document service (resume text extraction) -------------------------------------------
# Start it from backend/services/document-service (see backend/README.md), then set:
DOCUMENT_SERVICE_URL=
# Optional shared secret; set the same DOCUMENT_SERVICE_TOKEN in the document service's environment.
DOCUMENT_SERVICE_TOKEN=
DOCUMENT_TIMEOUT_MS=30000
