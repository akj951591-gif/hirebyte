# Caddy terminates HTTPS on the instance, so open port 443 (port 80 is already open for the
# Let's Encrypt challenge and the redirect).
Resources:
  httpsIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0
