option_settings:
  aws:elasticbeanstalk:command:
    Timeout: 1800
  # Caddy listens on ports 80 and 443 itself, so the platform's own nginx must not.
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: none
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: basic
commands:
  01_swap:
    command: |
      if [ ! -f /swapfile ]; then
        fallocate -l 2G /swapfile
        chmod 600 /swapfile
        mkswap /swapfile
        swapon /swapfile
      fi
