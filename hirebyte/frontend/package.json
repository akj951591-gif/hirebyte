{
  "name": "hirebyte-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
