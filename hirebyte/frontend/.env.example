# Frontend environment. Only genuinely public values may use the VITE_ prefix;
# never put API keys, LiveKit/R2/Grok secrets or tokens here.

# Base path of the Node API as seen by the browser. The Vite dev server proxies /api.
VITE_API_BASE_URL=/api

# true = use the in-browser FIXTURE transport (src/api/client/mockTransport.ts) instead of the
# real API. For isolated UI work only (PRD §6.1.6); must be false for integration acceptance.
VITE_USE_FIXTURES=false

# Dev-server proxy target for /api (not exposed to the browser).
API_PROXY_TARGET=http://localhost:4000

# true = show "Download PDF" (server-generated report). Leave false until the API implements
# GET /api/interviews/:id/export.pdf; recruiters can still use Print / save PDF.
VITE_SERVER_PDF_EXPORT=false
