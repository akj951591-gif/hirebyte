# HireByte environment variables (PRD v2.1 §12). Placeholders only; secrets are never committed.
#
# Each service reads its own file:
#   backend/api/.env      Node API: database, sessions, LiveKit, R2, recording policy
#                         (full annotated template: backend/api/.env.example)
#   frontend/.env.local   Browser build: only public VITE_ values (template: frontend/.env.example)
#
# Web / API
PORT=4000
WEB_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
DATABASE_URL=
SESSION_SECRET=

# AI (server only): Google Gemini by default (also xai, groq)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Python document service (backend/services/document-service)
DOCUMENT_SERVICE_URL=
DOCUMENT_SERVICE_TOKEN=

# LiveKit (server-only secret)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Recording storage (server only, private bucket; Supabase Storage via S3, or R2 / AWS S3)
STORAGE_PROVIDER=supabase
SUPABASE_PROJECT_REF=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=recordings
STORAGE_ENDPOINT=
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Recording policy
RECORDING_ENABLED=false
RECORDING_MODE=composite
RECORDING_RETENTION_DAYS=

# Optional hosted speech-to-text
STT_PROVIDER=
STT_API_KEY=

LOG_LEVEL=info
