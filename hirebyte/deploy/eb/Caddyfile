# HTTPS for the Elastic Beanstalk demo: Caddy gets Let's Encrypt certificates for both names
# (DNS must point at this instance first) and serves the built frontend plus the API.
{
	# The security group only opens TCP 443, so advertising HTTP/3 (UDP) would leave browsers
	# trying a QUIC path that can never work.
	servers {
		protocols h1 h2
	}
}

bulkblast.in {
	encode gzip zstd

	# Access log (cookies and Authorization headers are redacted by default); read with
	# docker compose logs caddy.
	log

	# Same origin as the SPA, so the session cookies and Socket.IO need no CORS.
	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		root * /srv/site
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

api.bulkblast.in {
	log
	reverse_proxy api:4000
}
